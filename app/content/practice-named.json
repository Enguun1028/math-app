{"_note": "Generated by research/search-fill/build.py from research/search-fill/practice-named-*.json. Draft.", "vieta": [{"level": 1, "q": "x² − 5x + 6 = 0 тэгшитгэлийн язгууруудын нийлбэр хэд вэ?", "choices": ["−5", "−6", "5", "6"], "answer": 2, "why": "x₁ + x₂ = −p = −(−5) = 5.", "traps": {"0": "−p-ийн хасах тэмдгийг давхар хэрэглэсэн.", "3": "Үржвэр (q)-ийг нийлбэр гэж авсан.", "1": "Үржвэрийг тэмдэг сольж авсан."}}, {"level": 2, "q": "x² + 3x − 10 = 0-ийн язгууруудын үржвэр хэд вэ?", "choices": ["−3", "−10", "3", "10"], "answer": 1, "why": "x₁ · x₂ = q = −10.", "traps": {"2": "x-ийн коэффициентийг авсан.", "0": "Нийлбэр (−3)-ийг авсан.", "3": "Сул гишүүний тэмдгийг алдсан."}}, {"level": 3, "q": "x² − 6x + 4 = 0-ийн язгуур x₁, x₂ бол x₁² + x₂² = ?", "choices": ["28", "44", "20", "36"], "answer": 0, "why": "x₁² + x₂² = (x₁ + x₂)² − 2x₁x₂ = 36 − 8 = 28.", "traps": {"3": "Зөвхөн (x₁ + x₂)²-ийг авсан.", "1": "2x₁x₂-ийг хасахын оронд нэмсэн.", "2": "4x₁x₂-ийг хассан."}}], "quad-formula": [{"level": 1, "q": "x² − 4x + 3 = 0-ийн шийдүүд аль нь вэ?", "choices": ["4 ба 3", "1 ба 3", "1 ба −3", "−1 ба −3"], "answer": 1, "why": "D = 16 − 12 = 4, x = \\frac{4 ± 2}{2}: 3 ба 1.", "traps": {"3": "−b-ийн тэмдгийг алдсан.", "2": "± хоёр тэмдгийг хольсон.", "0": "Коэффициентуудыг шийд гэж бичсэн."}}, {"level": 2, "q": "2x² + 3x − 2 = 0-ийн эерэг шийд?", "choices": ["−2", "1", "\\frac{1}{2}", "2"], "answer": 2, "why": "D = 9 + 16 = 25, x = \\frac{−3 + 5}{4} = \\frac{1}{2}.", "traps": {"3": "2a-ийн оронд 2-т хуваасан.", "1": "Хуваарийг мартсан (−3 + 5 = 2 гээд 2-т хуваасан).", "0": "Сөрөг шийдийг эерэг гэж сонгосон."}}, {"level": 3, "q": "x² − 2x − 1 = 0-ийн шийдүүд?", "choices": ["1 ± 2", "1 ± √2", "2 ± √2", "−1 ± √2"], "answer": 1, "why": "D = 4 + 4 = 8, √8 = 2√2, x = \\frac{2 ± 2√2}{2} = 1 ± √2.", "traps": {"0": "√8-ийг 4 гэж бодсон.", "2": "2-т хуваахдаа зөвхөн нэг гишүүнийг хуваасан.", "3": "−b-ийн тэмдгийг алдсан."}}], "discriminant": [{"level": 1, "q": "x² + 2x + 5 = 0 хэдэн бодит шийдтэй вэ?", "choices": ["Төгсгөлгүй олон", "0", "1", "2"], "answer": 1, "why": "D = 4 − 20 = −16 < 0.", "traps": {"2": "D-ийн тэмдгийг буруу тооцсон.", "3": "Квадрат тэгшитгэл үргэлж 2 шийдтэй гэж бодсон.", "0": "Тэгшитгэл ба адилтгалыг хольсон."}}, {"level": 2, "q": "x² − 6x + c = 0 ганц (давхардсан) шийдтэй байх c?", "choices": ["6", "36", "−9", "9"], "answer": 3, "why": "D = 36 − 4c = 0, c = 9.", "traps": {"2": "4c-ийн тэмдгийг алдсан.", "0": "b-г c гэж авсан.", "1": "b²-ийг c гэж авсан."}}, {"level": 3, "q": "x² + kx + 4 = 0 хоёр ялгаатай бодит шийдтэй байх k-ийн утга?", "choices": ["|k| < 4", "|k| > 4", "k > 16", "k > 4"], "answer": 1, "why": "D = k² − 16 > 0 ⇒ k² > 16 ⇒ k > 4 эсвэл k < −4.", "traps": {"3": "k < −4 хэсгийг мартсан.", "0": "Тэнцэтгэл бишийн чиглэлийг эргүүлсэн.", "2": "Квадрат язгуур гаргахаа мартсан."}}], "complete-square": [{"level": 1, "q": "x² + 8x-ийг бүтэн квадрат болгохын тулд хэд нэмэх вэ?", "choices": ["8", "4", "16", "64"], "answer": 2, "why": "(\\frac{8}{2})² = 16: x² + 8x + 16 = (x + 4)².", "traps": {"0": "Коэффициентийг шууд нэмсэн.", "1": "Хагасыг квадрат зэрэгт дэвшүүлээгүй.", "3": "Коэффициентийг бүтнээр нь квадрат зэрэгт дэвшүүлсэн."}}, {"level": 2, "q": "x² − 6x + 2-ийг (x − a)² + b хэлбэрээр бичнэ үү.", "choices": ["(x − 6)² + 2", "(x − 3)² − 7", "(x + 3)² − 7", "(x − 3)² + 2"], "answer": 1, "why": "x² − 6x + 9 − 9 + 2 = (x − 3)² − 7.", "traps": {"3": "Нэмсэн 9-өө хасахаа мартсан.", "0": "Коэффициентийг хагаслаагүй.", "2": "Хаалт доторх тэмдгийг алдсан."}}, {"level": 3, "q": "y = x² + 4x + 7-ийн хамгийн бага утга?", "choices": ["7", "−2", "3", "11"], "answer": 2, "why": "(x + 2)² + 3: квадрат хамгийн багадаа 0, тиймээс 3.", "traps": {"0": "Сул гишүүнийг хамгийн бага утга гэсэн.", "1": "Оройн x координатыг утга гэж авсан.", "3": "4-ийг хасахын оронд нэмсэн."}}], "parabola-vertex": [{"level": 1, "q": "y = x² − 6x + 1 параболын тэгш хэмийн тэнхлэг?", "choices": ["x = 1", "x = 6", "x = 3", "x = −3"], "answer": 2, "why": "x₀ = −\\frac{b}{2a} = \\frac{6}{2} = 3.", "traps": {"3": "−b-ийн тэмдгийг алдсан.", "1": "2a-д хуваахаа мартсан.", "0": "Сул гишүүнийг авсан."}}, {"level": 2, "q": "y = −2x² + 8x − 3-ийн хамгийн их утга?", "choices": ["2", "5", "13", "−3"], "answer": 1, "why": "x₀ = 2, y₀ = −8 + 16 − 3 = 5.", "traps": {"3": "Сул гишүүнийг хамгийн их утга гэсэн.", "0": "x₀-ийг утга гэж авсан.", "2": "−2 · 4-ийн тэмдгийг алдсан (8 + 16 − 3 гэж)."}}, {"level": 3, "q": "20 м хашаагаар нэг талыг нь хана болгон тэгш өнцөгт хашаа барина. Хамгийн их талбай?", "choices": ["100 м²", "50 м²", "40 м²", "25 м²"], "answer": 1, "why": "Хананд перпендикуляр тал x: S = x(20 − 2x), оройд x = 5, S = 5 · 10 = 50.", "traps": {"3": "4 талтай хашаа гэж бодсон (5 × 5).", "0": "Хашааг нэг тал л гэж бодсон.", "2": "Оройн x-ийг буруу олсон."}}], "sq-sum": [{"level": 1, "q": "(x + 3)² = ?", "choices": ["x² + 3x + 9", "x² + 9", "x² + 6x + 6", "x² + 6x + 9"], "answer": 3, "why": "x² + 2 · 3x + 3².", "traps": {"1": "2ab гишүүнийг мартсан.", "0": "2ab-ийн 2-ыг мартсан.", "2": "b²-ийг 2b гэж бодсон."}}, {"level": 2, "q": "(2a + 5)² = ?", "choices": ["2a² + 20a + 25", "4a² + 10a + 25", "4a² + 25", "4a² + 20a + 25"], "answer": 3, "why": "(2a)² + 2 · 2a · 5 + 25.", "traps": {"0": "2a-г бүхлээр нь квадрат зэрэгт дэвшүүлээгүй.", "1": "2ab-ийн 2-ыг мартсан.", "2": "Дунд гишүүнийг мартсан."}}, {"level": 3, "q": "a + b = 7, ab = 10 бол a² + b² = ?", "choices": ["69", "29", "49", "39"], "answer": 1, "why": "a² + b² = (a + b)² − 2ab = 49 − 20 = 29.", "traps": {"2": "(a + b)²-ийг a² + b² гэсэн.", "3": "Зөвхөн ab-г хассан.", "0": "2ab-ийг нэмсэн."}}], "diff-sq": [{"level": 1, "q": "x² − 49-ийг үржигдэхүүнд задална уу.", "choices": ["(x − 49)(x + 1)", "(x − 7)²", "(x + 7)²", "(x − 7)(x + 7)"], "answer": 3, "why": "a² − b² = (a − b)(a + b), b = 7.", "traps": {"1": "Ялгаврын квадраттай андуурсан.", "0": "49-ийн язгуурыг гаргаагүй.", "2": "Нийлбэрийн квадраттай андуурсан."}}, {"level": 2, "q": "102 · 98 = ?", "choices": ["9996", "10000", "10004", "9900"], "answer": 0, "why": "(100 + 2)(100 − 2) = 10000 − 4.", "traps": {"2": "4-ийг нэмсэн.", "3": "2-ыг 100-аар үржүүлж хассан.", "1": "2²-ийг тооцоогүй."}}, {"level": 3, "q": "\\frac{x² − 9}{x − 3} (x ≠ 3)-ийг хялбарчилна уу.", "choices": ["x + 3", "3", "x − 3", "x + 9"], "answer": 0, "why": "\\frac{(x − 3)(x + 3)}{x − 3} = x + 3.", "traps": {"2": "Буруу үржигдэхүүнийг үлдээсэн.", "3": "Гишүүнчлэн хураасан.", "1": "x-үүдийг хураасан."}}], "pow-rules": [{"level": 1, "q": "3² · 3⁴ = ?", "choices": ["6⁶", "3⁸", "9⁶", "3⁶"], "answer": 3, "why": "Суурь ижил: илтгэгчүүдийг нэмнэ.", "traps": {"1": "Илтгэгчүүдийг үржүүлсэн.", "2": "Суурийг үржүүлсэн.", "0": "Суурийг нэмсэн."}}, {"level": 2, "q": "(2³)² = ?", "choices": ["12", "32", "64", "36"], "answer": 2, "why": "2⁶ = 64.", "traps": {"1": "Илтгэгчүүдийг нэмсэн (2⁵).", "3": "6²-ыг бодсон.", "0": "Үржвэр гэж бодсон."}}, {"level": 3, "q": "\\frac{2⁵ · 4²}{8²} = ?", "choices": ["2", "4", "8", "16"], "answer": 2, "why": "2⁵ · 2⁴ : 2⁶ = 2³ = 8.", "traps": {"1": "4²-ийг 2²-оор сольсон.", "3": "8²-ийг 2⁵ гэж бодсон.", "0": "Илтгэгчийг үржүүлж хуваасан."}}], "log-laws": [{"level": 1, "q": "log₂ 8 + log₂ 4 = ?", "choices": ["5", "6", "12", "32"], "answer": 0, "why": "3 + 2 = 5 (эсвэл log₂ 32 = 5).", "traps": {"2": "Доорх тоонуудыг нэмсэн.", "3": "Доорх тоонуудын үржвэрийг хариу гэсэн.", "1": "log₂ 8-ийг 4 гэж бодсон."}}, {"level": 2, "q": "lg 200 − lg 2 = ?", "choices": ["2", "100", "lg 198", "198"], "answer": 0, "why": "lg \\frac{200}{2} = lg 100 = 2.", "traps": {"3": "Доорх тоонуудыг хассан.", "1": "Ногдворыг хариу гэж бичсэн.", "2": "Логарифмын ялгаврыг ялгаврын логарифм гэсэн."}}, {"level": 3, "q": "log₃ 54 − log₃ 2 = ?", "choices": ["52", "27", "4", "3"], "answer": 3, "why": "log₃ 27 = 3.", "traps": {"1": "Ногдворыг хариу гэж бичсэн.", "0": "Доорх тоонуудыг хассан.", "2": "3⁴ = 81-тэй андуурсан."}}], "ap-nth": [{"level": 1, "q": "2, 9, 16, 23, …-ийн 10-р гишүүн?", "choices": ["72", "63", "70", "65"], "answer": 3, "why": "a₁₀ = 2 + 9 · 7 = 65.", "traps": {"0": "(n − 1)-ийн оронд n авсан.", "2": "a₁-ийг тооцоогүй.", "1": "Ялгаврыг буруу олсон."}}, {"level": 2, "q": "a₁ = 5, a₈ = 26 бол ялгавар d?", "choices": ["4", "3", "\\frac{21}{8}", "21"], "answer": 1, "why": "26 = 5 + 7d, d = 3.", "traps": {"2": "7-ийн оронд 8-д хуваасан.", "3": "Ялгаврыг d гэж авсан.", "0": "Тоо бодолтын алдаа."}}, {"level": 3, "q": "Арифметик прогрессын a₃ = 11, a₇ = 27. a₁ = ?", "choices": ["−1", "4", "7", "3"], "answer": 3, "why": "4d = 16, d = 4, a₁ = 11 − 8 = 3.", "traps": {"2": "a₁ = a₃ − d гэж бодсон.", "0": "3d хассан.", "1": "d-г a₁ гэж авсан."}}], "ap-sum": [{"level": 1, "q": "1 + 2 + … + 50 = ?", "choices": ["1275", "2550", "1250", "1225"], "answer": 0, "why": "\\frac{50 · 51}{2} = 1275.", "traps": {"1": "2-т хуваахаа мартсан.", "2": "50 · 50 : 2 гэж бодсон.", "3": "49 · 50 : 2 гэж бодсон."}}, {"level": 2, "q": "3 + 7 + 11 + … эхний 10 гишүүний нийлбэр?", "choices": ["39", "420", "200", "210"], "answer": 3, "why": "a₁₀ = 39, S = \\frac{(3 + 39) · 10}{2} = 210.", "traps": {"0": "10-р гишүүнийг нийлбэр гэж авсан.", "1": "2-т хуваахаа мартсан.", "2": "a₁₀-ийг 37 гэж бодсон."}}, {"level": 3, "q": "100 хүртэлх 3-т хуваагддаг натурал тоонуудын нийлбэр?", "choices": ["3366", "1650", "1683", "1716"], "answer": 2, "why": "3, 6, …, 99: 33 гишүүн, \\frac{(3 + 99) · 33}{2} = 1683.", "traps": {"1": "Гишүүний тоог буруу (32.3) тоолсон.", "3": "34 гишүүн гэж бодсон.", "0": "2-т хуваахаа мартсан."}}], "gp-sum": [{"level": 1, "q": "1 + 3 + 9 + 27 + 81 = ?", "choices": ["81", "243", "121", "120"], "answer": 2, "why": "\\frac{3⁵ − 1}{3 − 1} = \\frac{242}{2} = 121.", "traps": {"1": "Дараагийн гишүүнийг хариу гэсэн.", "0": "Сүүлийн гишүүнийг хариу гэсэн.", "3": "Тооцооны алдаа (−1)."}}, {"level": 2, "q": "b₁ = 2, q = 2 бол эхний 6 гишүүний нийлбэр?", "choices": ["128", "126", "64", "62"], "answer": 1, "why": "\\frac{2(2⁶ − 1)}{1} = 126.", "traps": {"2": "6-р гишүүнийг авсан.", "0": "b₁ · 2⁶ гэж бодсон.", "3": "5 гишүүн тоолсон."}}, {"level": 3, "q": "Шатрын 64 нүдэнд 1, 2, 4, … будаа. Эхний 10 нүдэнд нийт хэд вэ?", "choices": ["512", "2047", "1024", "1023"], "answer": 3, "why": "2¹⁰ − 1 = 1023.", "traps": {"0": "10-р нүдний тоог авсан.", "2": "−1-ийг мартсан.", "1": "11 нүд тоолсон."}}], "gp-infinite": [{"level": 1, "q": "1 + \\frac{1}{3} + \\frac{1}{9} + … = ?", "choices": ["3", "\\frac{4}{3}", "Хязгааргүй", "\\frac{3}{2}"], "answer": 3, "why": "\\frac{1}{1 − \\frac{1}{3}} = \\frac{3}{2}.", "traps": {"0": "1-ийн оронд q-д хуваасан.", "1": "Эхний хоёр гишүүнийг л нэмсэн.", "2": "Төгсгөлгүй гишүүнтэй бол нийлбэр хязгааргүй гэж бодсон."}}, {"level": 2, "q": "0.(7)-ийг энгийн бутархай болгоно уу.", "choices": ["\\frac{7}{9}", "\\frac{7}{10}", "\\frac{7}{99}", "\\frac{1}{7}"], "answer": 0, "why": "\\frac{0.7}{1 − 0.1} = \\frac{7}{9}.", "traps": {"1": "Нэг цифрийг л авсан.", "2": "Хоёр оронтой үе гэж бодсон.", "3": "Цифрийг хуваарь болгосон."}}, {"level": 3, "q": "Бөмбөг 10 м-ээс унаад бүрт өмнөх өндрийнхөө хагас хүртэл үсэрнэ. Нийт хэдэн метр туулах вэ (дээш, доош)?", "choices": ["15 м", "20 м", "30 м", "Хязгааргүй"], "answer": 2, "why": "10 + 2(5 + 2.5 + …) = 10 + 2 · 10 = 30.", "traps": {"1": "Зөвхөн доош унасан замыг тоолсон.", "0": "Дээш үсэрсэн замыг нэг удаа тоолсон.", "3": "Төгсгөлгүй олон үсрэлт бол зам хязгааргүй гэж бодсон."}}], "compound-interest": [{"level": 1, "q": "100 000₮-ийг жилийн 10% нийлмэл хүүтэй 2 жил хадгалвал?", "choices": ["200 000₮", "121 000₮", "120 000₮", "110 000₮"], "answer": 1, "why": "100 000 · 1.1² = 121 000.", "traps": {"2": "Энгийн хүү гэж бодсон.", "3": "1 жил тоолсон.", "0": "Процентыг буруу хувиргасан."}}, {"level": 2, "q": "Аль нь илүү вэ: 2 жилд 20% энгийн хүү эсвэл жил бүр 10% нийлмэл хүү?", "choices": ["Тэнцүү", "Мөнгөнөөс хамаарна", "Энгийн", "Нийлмэл"], "answer": 3, "why": "1.1² = 1.21 > 1.20.", "traps": {"2": "Нийлмэл хүүг энгийн шиг тооцсон.", "0": "10% + 10% = 20% гэж бодсон.", "1": "Харьцаа мөнгөнөөс хамаарахгүйг анзаараагүй."}}, {"level": 3, "q": "Жилийн 10% нийлмэл хүүтэй мөнгө хамгийн багадаа хэдэн жилд 2 дахин өсөх вэ?", "choices": ["5", "8", "10", "7"], "answer": 1, "why": "1.1⁷ ≈ 1.95, 1.1⁸ ≈ 2.14.", "traps": {"2": "Энгийн хүү гэж бодсон (10 · 10% = 100%).", "0": "Хүүг 20% гэж андуурсан.", "3": "1.1⁷-ийг 2-оос их гэж тооцсон."}}], "pct-change": [{"level": 1, "q": "Үнэ 5 000₮-өөс 6 000₮ болсон. Хэдэн хувиар өссөн бэ?", "choices": ["10%", "20%", "16.7%", "1 000%"], "answer": 1, "why": "\\frac{1000}{5000} = 0.2 = 20%.", "traps": {"2": "Шинэ үнэд харьцуулсан.", "3": "Өөрчлөлтийг хувь гэж бичсэн.", "0": "Тооцооны алдаа."}}, {"level": 2, "q": "Ангийн тоо 40-өөс 30 болсон. Хэдэн хувиар буурсан бэ?", "choices": ["33.3%", "75%", "10%", "25%"], "answer": 3, "why": "\\frac{10}{40} = 25%.", "traps": {"0": "Шинэ тоонд харьцуулсан.", "2": "Өөрчлөлтийн тоог хувь гэж бичсэн.", "1": "Үлдсэн хувийг бичсэн."}}, {"level": 3, "q": "Бараа 25% хямдарч 60 000₮ болсон. Анхны үнэ?", "choices": ["75 000₮", "85 000₮", "80 000₮", "45 000₮"], "answer": 2, "why": "x · 0.75 = 60 000, x = 80 000.", "traps": {"0": "Шинэ үнэд 25% нэмсэн.", "1": "Шинэ үнэд 25 000 нэмсэн.", "3": "Шинэ үнээс 25% хассан."}}], "heron": [{"level": 1, "q": "Талууд нь 3, 4, 5 гурвалжны хагас периметр p?", "choices": ["5", "12", "6", "7.5"], "answer": 2, "why": "p = \\frac{3 + 4 + 5}{2} = 6.", "traps": {"1": "Периметрийг p гэж авсан.", "0": "Хамгийн урт талыг авсан.", "3": "Хуваах тоог буруу авсан."}}, {"level": 2, "q": "Талууд нь 5, 5, 6 гурвалжны талбай?", "choices": ["15", "24", "30", "12"], "answer": 3, "why": "p = 8, S = √(8 · 3 · 3 · 2) = √144 = 12.", "traps": {"0": "Хоёр талын үржвэрийн хагас гэж бодсон.", "1": "√ гаргахаа мартаад 144-ийг хувааж алдсан.", "2": "Талуудын үржвэр : 5 гэж бодсон."}}, {"level": 3, "q": "Талууд нь 13, 14, 15 гурвалжны 14 талд буулгасан өндөр?", "choices": ["13", "14", "6", "12"], "answer": 3, "why": "S = 84 (Героны томьёо), h = \\frac{2 · 84}{14} = 12.", "traps": {"2": "2-оор үржүүлэхээ мартсан.", "0": "Талыг өндөр гэж авсан.", "1": "Суурийг өндөр гэж авсан."}}], "sine-rule": [{"level": 1, "q": "\\frac{a}{sin α} = 10 бол багтаасан тойргийн радиус R?", "choices": ["5", "10", "20", "\\frac{1}{10}"], "answer": 0, "why": "\\frac{a}{sin α} = 2R, R = 5.", "traps": {"1": "2R-ийг R гэж авсан.", "2": "2-оор үржүүлсэн.", "3": "Урвуу харьцаа авсан."}}, {"level": 2, "q": "a = 6, α = 30°, β = 90° бол b?", "choices": ["3", "6", "12", "6√3"], "answer": 2, "why": "\\frac{6}{\\frac{1}{2}} = \\frac{b}{1}, b = 12.", "traps": {"0": "sin 30°-оор хуваахын оронд үржүүлсэн.", "3": "cos-ийг хэрэглэсэн.", "1": "Талууд тэнцүү гэж бодсон."}}, {"level": 3, "q": "Гурвалжинд α = 45°, β = 60°, a = 10. b ≈ ?", "choices": ["14.1", "12.2", "10", "8.2"], "answer": 1, "why": "b = \\frac{10 · sin 60°}{sin 45°} ≈ \\frac{8.66}{0.707} ≈ 12.2.", "traps": {"3": "Харьцааг урвуу авсан.", "0": "10√2-ийг бодсон.", "2": "Өнцгүүдийг үл тоосон."}}], "cosine-rule": [{"level": 1, "q": "α = 90° үед косинусын теорем юу болох вэ?", "choices": ["Пифагорын теорем", "Синусын теорем", "Гурвалжны тэнцэтгэл биш", "a = b + c"], "answer": 0, "why": "cos 90° = 0 тул a² = b² + c².", "traps": {"1": "Хоёр теоремыг андуурсан.", "3": "Квадратуудыг мартсан.", "2": "Тэнцэтгэл бишийг теоремтой андуурсан."}}, {"level": 2, "q": "b = 3, c = 5, α = 120° бол a?", "choices": ["8", "7", "√19", "√34"], "answer": 1, "why": "a² = 9 + 25 − 2 · 15 · (−\\frac{1}{2}) = 49.", "traps": {"2": "cos 120°-ийн тэмдгийг эерэг гэж авсан.", "0": "Талуудыг нэмсэн.", "3": "Сүүлийн гишүүнийг мартсан."}}, {"level": 3, "q": "Талууд нь 5, 7, 8 гурвалжны 7-ийн эсрэг өнцөг?", "choices": ["60°", "120°", "45°", "90°"], "answer": 0, "why": "cos θ = \\frac{25 + 64 − 49}{80} = \\frac{1}{2}, θ = 60°.", "traps": {"3": "Пифагор шалгалтыг хийгээгүй.", "2": "cos-ийн утгыг андуурсан.", "1": "Тэмдгийг алдсан."}}], "tri-angle-sum": [{"level": 1, "q": "Гурвалжны хоёр өнцөг 47° ба 68°. Гурав дахь нь?", "choices": ["65°", "115°", "75°", "245°"], "answer": 0, "why": "180° − 115° = 65°.", "traps": {"1": "Хоёр өнцгийн нийлбэрийг авсан.", "2": "Тооцооны алдаа.", "3": "360°-аас хассан."}}, {"level": 2, "q": "Адил хажуут гурвалжны суурийн өнцөг 70°. Оройн өнцөг?", "choices": ["70°", "40°", "55°", "110°"], "answer": 1, "why": "180° − 2 · 70° = 40°.", "traps": {"0": "Бүх өнцөг тэнцүү гэж бодсон.", "3": "Нэг суурийн өнцгийг л хассан.", "2": "Оройн өнцгийг суурийнх гэж бодсон."}}, {"level": 3, "q": "Гурвалжны өнцгүүд 2 : 3 : 4 харьцаатай. Хамгийн их өнцөг?", "choices": ["80°", "90°", "40°", "60°"], "answer": 0, "why": "9 хэсэг = 180°, 1 хэсэг = 20°, 4 · 20 = 80°.", "traps": {"2": "Хамгийн бага өнцгийг сонгосон.", "1": "Тэгш өнцөгт гэж таамагласан.", "3": "Дунд өнцгийг сонгосон."}}], "polygon-angle-sum": [{"level": 1, "q": "Найман өнцөгтийн дотоод өнцгүүдийн нийлбэр?", "choices": ["1440°", "1080°", "900°", "720°"], "answer": 1, "why": "(8 − 2) · 180° = 1080°.", "traps": {"0": "n · 180° гэж бодсон.", "3": "n − 4 авсан.", "2": "Долоон өнцөгтийнхийг бодсон."}}, {"level": 2, "q": "Зөв арван өнцөгтийн нэг дотоод өнцөг?", "choices": ["160°", "36°", "180°", "144°"], "answer": 3, "why": "\\frac{8 · 180°}{10} = 144°.", "traps": {"1": "Гадаад өнцгийг авсан.", "0": "n · 180 : 10 − 20 гэж бодсон.", "2": "Шулуун өнцөг гэж бодсон."}}, {"level": 3, "q": "Зөв олон өнцөгтийн гадаад өнцөг 24°. Хэдэн талтай вэ?", "choices": ["15", "24", "12", "18"], "answer": 0, "why": "360° : 24° = 15.", "traps": {"1": "Өнцгийг талын тоо гэж бодсон.", "2": "180-д хуваасан (7.5) гэж ойролцоолсон.", "3": "Тооцооны алдаа."}}], "pyth-triples": [{"level": 1, "q": "Аль нь Пифагорын гурвал вэ?", "choices": ["4, 5, 6", "2, 3, 4", "6, 8, 10", "5, 6, 7"], "answer": 2, "why": "36 + 64 = 100.", "traps": {"0": "Дараалсан тоо гэж сонгосон.", "1": "Дараалсан тоо гэж сонгосон.", "3": "Дараалсан тоо гэж сонгосон."}}, {"level": 2, "q": "Катет 9, гипотенуз 15 бол нөгөө катет?", "choices": ["12", "24", "6", "√306"], "answer": 0, "why": "√(225 − 81) = √144 = 12.", "traps": {"2": "Талуудыг хассан.", "3": "Квадратуудыг нэмсэн.", "1": "Талуудыг нэмсэн."}}, {"level": 3, "q": "5, 12, 13-ыг 3 дахин томруулбал гипотенуз?", "choices": ["13", "169", "16", "39"], "answer": 3, "why": "13 · 3 = 39.", "traps": {"2": "3 нэмсэн.", "0": "Томруулаагүй.", "1": "Квадрат зэрэгт дэвшүүлсэн."}}], "thales-circle": [{"level": 1, "q": "AB диаметр, C тойрог дээр. ∠ACB = ?", "choices": ["45°", "60°", "180°", "90°"], "answer": 3, "why": "Диаметрт тулсан багтсан өнцөг тэгш өнцөг.", "traps": {"2": "Нумын градусыг авсан.", "1": "Зөв гурвалжин гэж бодсон.", "0": "Хагас тэгш өнцөг гэж бодсон."}}, {"level": 2, "q": "AB = 10 диаметр, AC = 6. BC = ?", "choices": ["4", "8", "16", "√136"], "answer": 1, "why": "∠C = 90°, BC = √(100 − 36) = 8.", "traps": {"0": "Хассан.", "3": "Квадратуудыг нэмсэн.", "2": "Нэмсэн."}}, {"level": 3, "q": "Тэгш өнцөгт гурвалжны гипотенуз 26 бол багтаасан тойргийн радиус?", "choices": ["13", "52", "26", "6.5"], "answer": 0, "why": "Гипотенуз нь диаметр: R = 13.", "traps": {"2": "Диаметрийг радиус гэсэн.", "1": "2-оор үржүүлсэн.", "3": "4-т хуваасан."}}], "circle-equation": [{"level": 1, "q": "(x − 2)² + (y + 1)² = 16 тойргийн төв ба радиус?", "choices": ["(2; 1), 4", "(2; −1), 16", "(−2; 1), 4", "(2; −1), 4"], "answer": 3, "why": "Төв (a; b) = (2; −1), R = √16 = 4.", "traps": {"2": "Тэмдгийг эргүүлсэн.", "1": "R²-ийг R гэж авсан.", "0": "b-ийн тэмдгийг алдсан."}}, {"level": 2, "q": "Төв (0; 3), радиус 5 тойргийн тэгшитгэл?", "choices": ["x² + (y − 3)² = 25", "x² + (y − 3)² = 5", "(x − 3)² + y² = 25", "x² + (y + 3)² = 25"], "answer": 0, "why": "(x − 0)² + (y − 3)² = 5².", "traps": {"3": "Тэмдгийг эргүүлсэн.", "1": "R-ийг квадрат зэрэгт дэвшүүлээгүй.", "2": "x ба y-ийг сольсон."}}, {"level": 3, "q": "x² + y² − 4x + 6y − 3 = 0 тойргийн радиус?", "choices": ["4", "√13", "√3", "16"], "answer": 0, "why": "(x − 2)² + (y + 3)² = 3 + 4 + 9 = 16, R = 4.", "traps": {"2": "Сул гишүүнийг л авсан.", "3": "R²-ийг R гэсэн.", "1": "Сул гишүүнийг тооцоогүй."}}], "trig-pyth": [{"level": 1, "q": "sin²40° + cos²40° = ?", "choices": ["1", "40", "0", "2"], "answer": 0, "why": "Дурын өнцөгт sin² + cos² = 1.", "traps": {"2": "Хасах гэж бодсон.", "3": "Хоёуланг нь 1 гэж бодсон.", "1": "Өнцгийг хариу гэж бичсэн."}}, {"level": 2, "q": "cos α = \\frac{5}{13}, α хурц бол sin α?", "choices": ["\\frac{8}{13}", "\\frac{5}{12}", "\\frac{12}{13}", "\\frac{13}{12}"], "answer": 2, "why": "sin²α = 1 − \\frac{25}{169} = \\frac{144}{169}.", "traps": {"0": "Хүртвэрүүдийг хассан.", "3": "Урвуу харьцаа авсан.", "1": "tg-ийн урвууг авсан."}}, {"level": 3, "q": "sin α = \\frac{3}{5}, α мохоо бол cos α?", "choices": ["\\frac{4}{5}", "−\\frac{4}{5}", "−\\frac{3}{5}", "\\frac{5}{4}"], "answer": 1, "why": "cos²α = \\frac{16}{25}, II мөчид cos < 0.", "traps": {"0": "Мөчийн тэмдгийг тооцоогүй.", "2": "sin-ийг тэмдэг сольж бичсэн.", "3": "Урвуу харьцаа авсан."}}], "special-angles": [{"level": 1, "q": "sin 30° = ?", "choices": ["\\frac{1}{2}", "\\frac{√2}{2}", "\\frac{√3}{2}", "1"], "answer": 0, "why": "30°-ын эсрэг катет гипотенузын хагас.", "traps": {"2": "cos 30°-тай андуурсан.", "3": "sin 90°-тай андуурсан.", "1": "45°-тай андуурсан."}}, {"level": 2, "q": "tg 60° = ?", "choices": ["\\frac{1}{2}", "1", "√3", "\\frac{√3}{3}"], "answer": 2, "why": "\\frac{sin 60°}{cos 60°} = \\frac{√3}{2} : \\frac{1}{2} = √3.", "traps": {"3": "tg 30°-тай андуурсан.", "1": "tg 45°-тай андуурсан.", "0": "cos 60°-тай андуурсан."}}, {"level": 3, "q": "2sin 45° · cos 45° = ?", "choices": ["\\frac{√2}{2}", "1", "√2", "\\frac{1}{2}"], "answer": 1, "why": "2 · \\frac{√2}{2} · \\frac{√2}{2} = 1 (= sin 90°).", "traps": {"0": "Нэг хүчин зүйлийг л тооцсон.", "2": "2-оор үржүүлээд үржвэрийг алдсан.", "3": "2-оор үржүүлэхээ мартсан."}}], "sphere": [{"level": 1, "q": "R = 3 бөмбөрцгийн гадаргуугийн талбай?", "choices": ["36π", "9π", "12π", "108π"], "answer": 0, "why": "4πR² = 36π.", "traps": {"2": "4πR гэж бодсон.", "1": "Дугуйн талбайг авсан.", "3": "R³ хэрэглэсэн."}}, {"level": 2, "q": "R = 3 бөмбөрцгийн эзэлхүүн?", "choi