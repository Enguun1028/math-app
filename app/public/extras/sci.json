{"q": [{"level": 1, "q": "52 000 000-ыг стандарт хэлбэрээр бичнэ үү.", "choices": ["52 × 10⁶", "5.2 × 10⁶", "5.2 × 10⁷", "0.52 × 10⁸"], "answer": 2, "why": "A × 10ⁿ, 1 ≤ A < 10: 52 000 000 = 5.2 × 10⁷.", "traps": {"0": "1 ≤ A < 10 нөхцөлийг зөрчсөн (52 > 10).", "3": "1 ≤ A < 10 нөхцөлийг зөрчсөн (0.52 < 1).", "1": "Таслалыг шилжүүлсэн оронг буруу тоолсон."}}, {"level": 1, "q": "3 × 10⁻⁴-ийг аравтын бутархайгаар бичнэ үү.", "choices": ["−30 000", "0.003", "0.00003", "0.0003"], "answer": 3, "why": "10⁻⁴ = 0.0001 тул 3 × 10⁻⁴ = 0.0003.", "traps": {"1": "Сөрөг илтгэгчтэй тоог аравтын бутархай болгохдоо нэг орон дутуу шилжүүлсэн.", "2": "Сөрөг илтгэгчтэй тоог аравтын бутархай болгохдоо нэг орон илүү шилжүүлсэн.", "0": "Сөрөг илтгэгчийг сөрөг тоо гэж ойлгосон."}}, {"level": 2, "q": "Аль тоо хамгийн бага вэ?", "choices": ["9 × 10⁻⁵", "5 × 10⁻⁴", "2 × 10⁻³", "1 × 10⁻²"], "answer": 0, "why": "Сөрөг илтгэгчийн модуль их тусам тоо бага: 9 × 10⁻⁵ = 0.00009.", "traps": {"3": "Сөрөг илтгэгчтэй тоог зөвхөн A-аар нь (1 < 2 < 5 < 9) харьцуулсан.", "2": "Сөрөг илтгэгчтэй тоог буруу харьцуулж, A-г нь гол болгосон.", "1": "Илтгэгчийн тэмдгийг үл тоосон."}}, {"level": 2, "q": "(4 × 10⁵) · (6 × 10³)-ийг стандарт хэлбэрээр бичнэ үү.", "choices": ["24 × 10⁸", "2.4 × 10⁹", "2.4 × 10⁸", "2.4 × 10¹⁵"], "answer": 1, "why": "4 · 6 = 24, 10⁵ · 10³ = 10⁸. 24 × 10⁸ = 2.4 × 10⁹.", "traps": {"0": "1 ≤ A < 10 нөхцөлийг зөрчсөн (24 > 10).", "2": "A-г засахдаа илтгэгчийг өөрчлөөгүй.", "3": "10-ын зэргүүдийг үржүүлэхдээ илтгэгчийг үржүүлсэн."}}, {"level": 3, "q": "\\frac{1.2 × 10⁻³}{4 × 10⁵} = ? (стандарт хэлбэрээр)", "choices": ["0.3 × 10⁻⁸", "3 × 10⁻⁹", "3 × 10⁻⁸", "3 × 10⁻⁷", "3 × 10²"], "answer": 1, "why": "1.2 : 4 = 0.3, 10⁻³ : 10⁵ = 10⁻⁸. 0.3 × 10⁻⁸ = 3 × 10⁻⁹.", "traps": {"0": "1 ≤ A < 10 нөхцөлийг зөрчсөн (0.3 < 1).", "2": "0.3-ыг 3 болгохдоо илтгэгчийг өөрчлөөгүй.", "3": "A-г засахдаа илтгэгчийг буруу чиглэлд өөрчилсөн.", "4": "Илтгэгчүүдийг хасахдаа тэмдгийг алдсан (−3 + 5)."}}], "mis": [{"wrong": "Стандарт дүрсийн 1 ≤ a < 10 нөхцөлийг зөрчих", "example": "40 000 000 = 40 × 10⁶ гэх (зөв нь 4 × 10⁷)", "why": "Утга нь зөв тул хэлбэрийн шаардлагыг ач холбогдолгүй гэж боддог.", "fix": "Стандарт дүрсийн тодорхойлолтыг сануулж, a-г шалгах алхам нэмнэ.", "src": "https://map.mathshell.org/lessons.php?unit=8100&collection=8"}, {"wrong": "Сөрөг илтгэгчтэй тоог аравтын бутархай болгохдоо алдах", "example": "1 × 10⁻² = 0.001 гэх (зөв нь 0.01)", "why": "Илтгэгчийг «тэгийн тоо» гэж тоолдог.", "fix": "10⁻¹ = 0.1, 10⁻² = 0.01 гэх хүснэгт бөглүүлнэ.", "src": "https://map.mathshell.org/lessons.php?unit=8100&collection=8"}, {"wrong": "Сөрөг илтгэгчтэй тоог буруу харьцуулах", "example": "8 × 10⁻⁴ > 1 × 10⁻² гэх (зөв нь 0.0008 < 0.01)", "why": "Зөвхөн a-г (8 > 1) хардаг, илтгэгчийг анхаардаггүй.", "fix": "Хоёуланг аравтын бутархайгаар бичүүлж харьцуулуулна.", "src": "https://map.mathshell.org/lessons.php?unit=8100&collection=8"}], "rw": [{"title": "Хүн ам ба ноолуур", "text": "Том тоог стандарт дүрсээр бичвэл харьцуулахад амар.", "mini": "3,534,503 ≈ ? Хариу: 3.53 × 10⁶.", "src": "https://en.wikipedia.org/wiki/Demographics_of_Mongolia"}, {"title": "Сансар", "text": "Дэлхийгээс Нар хүртэл ойролцоогоор 1.496 × 10⁸ км (1 одон орны нэгж).", "mini": "Гэрэл 3 × 10⁵ км/с бол хэдэн секундэд хүрэх вэ? Хариу: 1.496 × 10⁸ : (3 × 10⁵) ≈ 499 с ≈ 8.3 мин.", "src": "https://en.wikipedia.org/wiki/Astronomical_unit"}], "v": [{"t": "Тоог стандарт хэлбэрээр бичих", "ch": "KhanAcademyMongolian", "min": 4.2, "url": "https://www.youtube.com/watch?v=KQdJzMRtXRA"}, {"t": "Суртлаа давт №51 | Тооны стандарт хэлбэр", "ch": "iMath математик сургалтын систем (8x100)", "min": 3.7, "url": "https://www.youtube.com/watch?v=jfDvN30GL84"}, {"t": "Тооны стандарт дүрс, тоог жиших, тоймлох", "ch": "БШУЯ теле хичээл", "min": 15.4, "url": "https://econtent.edu.mn/lessons/EBS/9rangi/mat/3198"}, {"t": "11/20/2020 Тоог тоймлох", "ch": "БШУЯ теле хичээл", "min": 19.6, "url": "https://econtent.edu.mn/lessons/EBS/8rangi/mat/3147"}], "it": [{"n": "Illustrative Mathematics Grade 8 Unit 7: Exponents and Scientific Notation", "url": "https://im.kendallhunt.com/MS/students/3/7/index.html", "k": "task", "mn": false}], "esh": {"n": 2, "pts": 3.0}}