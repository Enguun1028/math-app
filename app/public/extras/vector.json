{"q": [{"level": 1, "q": "a = (2, 5), b = (3, −1) бол a + b хэд вэ?", "choices": ["(−1, 6)", "(6, −5)", "(5, 6)", "(5, 4)"], "answer": 3, "why": "Харгалзах координатуудыг нэмнэ: (2 + 3, 5 + (−1)) = (5, 4).", "traps": {"0": "Нэмэхийн оронд хассан (a − b).", "1": "Координатуудыг үржүүлсэн.", "2": "−1-ийн тэмдгийг алдсан."}}, {"level": 1, "q": "A(1, 3), B(4, 7) бол AB векторын координат хэд вэ?", "choices": ["(4, 7)", "(−3, −4)", "(3, 4)", "(5, 10)"], "answer": 2, "why": "Төгсгөлөөс эхлэлийг хасна: (4 − 1, 7 − 3) = (3, 4).", "traps": {"0": "Векторыг B цэгийн координаттай хольсон.", "1": "Эхлэлээс төгсгөлийг хассан (BA вектор).", "3": "Хасахын оронд нэмсэн."}}, {"level": 2, "q": "|a| = 6, |b| = 8, a ⊥ b. |a + b| хэд вэ?", "choices": ["2", "100", "14", "10"], "answer": 3, "why": "Перпендикуляр векторуудын нийлбэр гурвалжны гипотенуз: √(36 + 64) = 10.", "traps": {"0": "Векторын уртуудыг тоо шиг хассан.", "1": "Язгуур гаргахаа мартсан.", "2": "Векторын уртуудыг тоо шиг нэмсэн."}}, {"level": 2, "q": "a = (4, −2), b = (1, 3) бол a − b хэд вэ?", "choices": ["(3, 1)", "(5, 1)", "(3, −5)", "(−3, 5)"], "answer": 2, "why": "(4 − 1, −2 − 3) = (3, −5).", "traps": {"0": "Хоёр дахь координатын тэмдгийг алдсан.", "1": "Хасахын оронд нэмсэн (b-г эсрэг вектор болгоогүй).", "3": "b − a-г олсон."}}, {"level": 3, "q": "a = (3, −4) бол |2a| хэд вэ?", "choices": ["10", "5", "14", "(6, −8)"], "answer": 0, "why": "2a = (6, −8), |2a| = √(36 + 64) = 10.", "traps": {"1": "2-оор үржүүлэхээ мартсан (|a| = 5).", "2": "Векторын уртыг координатуудын модулийн нийлбэрээр (6 + 8) олсон.", "3": "Уртын оронд векторыг өөрийг нь бичсэн."}}], "mis": [{"wrong": "Векторын хасалтыг нэмэлттэй хольдог.", "example": "a − b-г зурахдаа b-г эргүүлэлгүй a-ийн үзүүрт залгана.", "why": "−b нь эсрэг чиглэлтэй вектор гэдгийг ашигладаггүй.", "fix": "a − b = a + (−b) гэж бичүүлж, −b-г тусад нь зуруулна.", "src": "https://journals.helsinki.fi/lumat/article/download/2993/2471/12440"}, {"wrong": "Векторын уртыг тоо шиг нэмдэг.", "example": "|a| = 3, |b| = 4, a ⊥ b үед |a + b| = 7 гэнэ; зөв нь √(9 + 16) = 5.", "why": "Векторыг чиглэлгүй тоо гэж үздэг.", "fix": "Сум зурж, гурвалжны дүрмээр уртыг хэмжүүлнэ.", "src": "https://journals.helsinki.fi/lumat/article/download/2993/2471/12440"}, {"wrong": "Векторуудыг үзүүрээс үзүүрт залгадаг.", "example": "a + b-г зурахдаа хоёр векторын үзүүрийг нийлүүлнэ.", "why": "Гурвалжны дүрэмд «эхлэлийг үзүүрт» залгахыг ойлгоогүй.", "fix": "Шилжилт гэж тайлбарлан: эхлээд a, дараа нь тэр цэгээс b алхана.", "src": "https://events.saip.org.za/event/86/attachments/2181/2888/SAIP2016_349.pdf"}], "rw": [{"title": "Салхи ба онгоц", "text": "Нисгэгч онгоцны хурд ба салхийг вектороор нэмж жинхэнэ чиглэлээ олдог.", "mini": "Завь 4 км/ц, урсгал перпендикуляр 3 км/ц. Үр дүнгийн хурд? Хариу: √(16 + 9) = 5 км/ц.", "src": null}, {"title": "Тоглоомын физик", "text": "Тоглоомын дүрийн хурдыг (x, y) вектороор хадгалдаг.", "mini": "(3, 4) векторын урт? Хариу: 5.", "src": null}], "v": [{"t": "Суртлаа давт №73 Векторын нэмэх үйлдэл-1", "ch": "iMath математик сургалтын систем (8x100)", "min": 3.6, "url": "https://www.youtube.com/watch?v=gy6kGNDDwdE"}, {"t": "Математик 10-р анги \"Хавтгай дээрх вектор\" I хэсэг", "ch": "Enkhmunkh Z", "min": 7.1, "url": "https://www.youtube.com/watch?v=xDUpkb6KBLA"}, {"t": "Вектор", "ch": "БШУЯ теле хичээл", "min": 19.6, "url": "https://econtent.edu.mn/lessons/EBS/9rangi/mat/1600"}, {"t": "Координатын хавтгай дахь вектор", "ch": "БШУЯ теле хичээл", "min": 23.1, "url": "https://econtent.edu.mn/lessons/EBS/10rangi/mat/1864"}], "it": [{"n": "Векторын Нийлбэр", "url": "https://phet.colorado.edu/sims/html/vector-addition/latest/vector-addition_mn.html", "k": "phet", "mn": true}, {"n": "Векторын Нийлбэр: Томъёо", "url": "https://phet.colorado.edu/sims/html/vector-addition-equations/latest/vector-addition-equations_mn.html", "k": "phet", "mn": true}], "esh": {"n": 6, "pts": 13.0}}