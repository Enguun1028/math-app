{"q": [{"level": 1, "q": "3ˣ = 81 тэгшитгэлийг бодно уу.", "choices": ["27", "4", "3", "78"], "answer": 1, "why": "81 = 3⁴ тул 3ˣ = 3⁴, x = 4.", "traps": {"0": "Илтгэгч тэгшитгэлийг хуваахаар бодсон (81 : 3).", "2": "Суурийг хариу гэж авсан.", "3": "Хасахаар бодсон (81 − 3)."}}, {"level": 1, "q": "2ˣ = \\frac{1}{8} тэгшитгэлийг бодно уу.", "choices": ["3", "−4", "−3", "1/16"], "answer": 2, "why": "\\frac{1}{8} = 2⁻³ тул x = −3.", "traps": {"3": "Илтгэгч тэгшитгэлийг хуваахаар бодсон (1/8 : 2).", "0": "Сөрөг илтгэгчийг орхисон.", "1": "8-ыг 2⁴ гэж буруу задалсан."}}, {"level": 2, "q": "9ˣ = 27 тэгшитгэлийг бодно уу.", "choices": ["3", "2/3", "1", "3/2"], "answer": 3, "why": "Ижил суурьт оруулна: 3²ˣ = 3³, 2x = 3, x = 3/2.", "traps": {"0": "Илтгэгч тэгшитгэлийг хуваахаар бодсон (27 : 9).", "2": "Ижил суурьт оруулахгүйгээр ойролцоогоор таамагласан.", "1": "Илтгэгчүүдийг тэнцүүлэхдээ урвуу харьцуулсан."}}, {"level": 2, "q": "5ˣ⁺¹ = 125 тэгшитгэлийг бодно уу.", "choices": ["2", "3", "24", "25"], "answer": 0, "why": "125 = 5³ тул x + 1 = 3, x = 2.", "traps": {"2": "Илтгэгч тэгшитгэлийг хуваахаар бодоод 1-ийг хассан (125 : 5 − 1).", "3": "Илтгэгч тэгшитгэлийг хуваахаар бодсон (125 : 5).", "1": "x + 1 = 3-аас x-ийг олохоо мартсан."}}, {"level": 3, "q": "8ˣ = 4ˣ⁺¹ тэгшитгэлийг бодно уу.", "choices": ["x = 2", "Шийдгүй", "x = 1", "x = −2", "x = 1/2"], "answer": 0, "why": "Ижил суурь 2: 2³ˣ = 2²⁽ˣ⁺¹⁾, 3x = 2x + 2, x = 2. Шалгах: 8² = 64 = 4³.", "traps": {"1": "Ижил суурьт оруулахгүйгээр илтгэгчийг тэнцүүлсэн (x = x + 1 тул шийдгүй гэсэн).", "2": "Ижил суурьт оруулахдаа (x + 1)-ийн зөвхөн нэг гишүүнийг 2-оор үржүүлсэн (3x = 2x + 1).", "3": "Илтгэгчийг шилжүүлэхдээ тэмдгийг алдсан.", "4": "Хариуг урвуу тоогоор бичсэн."}}], "mis": [{"wrong": "Илтгэгч тэгшитгэлийг хуваахаар бодох", "example": "2ˣ = 8 → x = 8 : 2 = 4 гэх (зөв нь x = 3)", "why": "Зэргийг үржвэр гэж ойлгодог.", "fix": "2ˣ = 2³ гэж ижил суурьтай болгож илтгэгчийг тэнцүүлүүлнэ.", "src": "https://journal.unpas.ac.id/index.php/pendas/article/view/33260"}, {"wrong": "Ижил суурьт оруулахгүйгээр илтгэгчийг тэнцүүлэх", "example": "4ˣ = 8 → x = 2 гэх (зөв нь 2²ˣ = 2³, x = 3/2)", "why": "Суурь өөр үед илтгэгчийг шууд харьцуулж болохгүйг анзаардаггүй.", "fix": "Хариуг орлуулж шалгуулна: 4² = 16 ≠ 8.", "src": "https://journal.unpas.ac.id/index.php/pendas/article/view/33260"}], "rw": [{"title": "Мэдээ тархах", "text": "Нийтлэл хуваалцагдах бүрд 2 дахин олон хүнд хүрвэл хэдэн алхамд хүрэхийг илтгэгч тэгшитгэлээр олно.", "mini": "2ˣ = 32. Хариу: x = 5.", "src": null}, {"title": "Хадгаламж давхардах", "text": "Мөнгө хэзээ 4 дахин өсөхийг тооцоолно.", "mini": "2ˣ = 4 × 2³ бол x? Хариу: 2ˣ = 2⁵, x = 5.", "src": null}], "v": [{"t": "Хялбар илтгэгч тэгшитгэл бодох аргууд", "ch": "A+ МАТЕМАТИК (A+Math)", "min": 1.4, "url": "https://www.youtube.com/watch?v=of0ZPudop_I"}, {"t": "Илтгэгч тэгшитгэл бодох орлуулах арга", "ch": "Togtokh Otgonbayar", "min": 1.6, "url": "https://www.youtube.com/watch?v=fl3RByYKSms"}], "it": [{"n": "Illustrative Mathematics Algebra 2 Unit 4: Exponential Functions and Equations", "url": "https://im.kendallhunt.com/HS/students/3/4/index.html", "k": "task", "mn": false}], "esh": {"n": 1, "pts": 2.0}}