{"q": [{"level": 1, "q": "3/5-ийг аравтын бутархайгаар бичнэ үү.", "choices": ["3.5", "0.6", "1.67", "0.35"], "answer": 1, "why": "3 : 5 = 0.6.", "traps": {"0": "Бутархайн цифрүүдийг таслалаар холбосон.", "2": "Хуваарийг хүртвэрт хуваасан (5 : 3).", "3": "Бутархайн цифрүүдийг таслалын ард залгасан."}}, {"level": 1, "q": "7/20-ийг процентоор бичнэ үү.", "choices": ["2.86%", "7.2%", "35%", "0.35%"], "answer": 2, "why": "7/20 = 35/100 = 35%.", "traps": {"1": "Бутархайн цифрүүдийг таслалаар холбосон.", "0": "Хуваарийг хүртвэрт хуваасан (20 : 7).", "3": "100-аар үржүүлэхээ мартсан."}}, {"level": 2, "q": "1/3-ыг процентоор яг зөв бичсэн нь аль вэ?", "choices": ["33%", "33.3%", "3%", "33 1/3 %"], "answer": 3, "why": "1/3 = 0.333… = 33 1/3 %. 33% ба 33.3% нь ойролцоо утга.", "traps": {"0": "33%-ийг яг 1/3 гэж бодсон.", "1": "Ойролцоо утгыг (33.3%) яг утга гэж бодсон.", "2": "Бутархайн цифрийг шууд процент гэж авсан."}}, {"level": 2, "q": "Аль нь хамгийн их вэ: 3/8, 0.4, 35%?", "choices": ["0.4", "3/8", "35%", "Бүгд тэнцүү"], "answer": 0, "why": "Аравтын бутархайгаар: 3/8 = 0.375, 0.4, 35% = 0.35. Хамгийн их нь 0.4.", "traps": {"1": "Хуваарийг хүртвэрт хуваасан (8 : 3 ≈ 2.67).", "2": "35-ыг 0.4-өөс их гэж процентыг хувиргалгүй харьцуулсан.", "3": "Хэлбэр өөр тул харьцуулахгүй таамагласан."}}, {"level": 3, "q": "40 сурагчийн 3/8 нь хөл бөмбөг, 0.3 нь сагсан бөмбөг, үлдсэн нь шатар сонгов. Шатар сонгосон сурагч нийт сурагчдын хэдэн хувь вэ?", "choices": ["32%", "32.5%", "13%", "67.5%"], "answer": 1, "why": "3/8 = 0.375. 1 − 0.375 − 0.3 = 0.325 = 32.5% (40 сурагчийн 13 нь).", "traps": {"0": "3/8-ыг 0.38 гэж цифрүүдийг холбож бичсэн.", "2": "Хүний тоог (13) процент гэж авсан.", "3": "Хөл бөмбөг, сагсан бөмбөгийн нийлбэрийг олсон."}}], "mis": [{"wrong": "33%-ийг яг 1/3 гэж бодох", "example": "1/3 = 33% гэж бичих (зөв нь ойролцоогоор 33.3%)", "why": "Ойролцоо утгыг яг тэнцүү гэж үздэг.", "fix": "1 : 3 = 0.333...-ийг хувааж, үргэлжилсэн бутархай гэдгийг харуулна.", "src": "https://map.mathshell.org/lessons.php?unit=6120&collection=8"}, {"wrong": "Хуваарийг хүртвэрт хуваах", "example": "3/4 = 4 : 3 ≈ 1.33 гэх (зөв нь 3 : 4 = 0.75)", "why": "Бутархайн шугам нь хуваах үйлдэл, ямар дарааллаар гэдгийг ойлгоогүй.", "fix": "«3 талхыг 4 хүнд хуваах» нөхцөлөөр утгыг нь тайлбарлана.", "src": "https://map.mathshell.org/lessons.php?unit=8105&collection=8"}, {"wrong": "Бутархайн цифрүүдийг таслалаар холбох", "example": "3/5 = 3.5 гэх (зөв нь 0.6)", "why": "Хоёр цифрийг таслалаар холбосон нь бутархайн бичлэг гэж боддог.", "fix": "3/5 нь 1-ээс бага тул 3.5 байж болохгүйг ярилцаж, 6/10 болгон хувиргуулна.", "src": "https://map.mathshell.org/lessons.php?unit=8105&collection=8"}], "rw": [{"title": "Шалгалтын хувь", "text": "Оноог хувь болговол өөр өөр шалгалтыг харьцуулж болно.", "mini": "24-өөс 18 оноо = ? Хариу: 18/24 = 0.75 = 75%.", "src": null}, {"title": "Хямдралын үнэ", "text": "«3/8 хямдрал» гэхээс «37.5%» гэж ихэвчлэн бичдэг.", "mini": "3/8-ыг аравтын болон хувиар? Хариу: 0.375 = 37.5%.", "src": null}], "v": [{"t": "Энгийн бутархайг аравтын бутархай руу шилжүүлэх", "ch": "KhanAcademyMongolian", "min": 2.6, "url": "https://www.youtube.com/watch?v=kN9LoWV55ss"}, {"t": "Аравтын бутархайг процент руу шилжүүлэх жишээ 2", "ch": "KhanAcademyMongolian", "min": 1.8, "url": "https://www.youtube.com/watch?v=bZI0FoCG7zw"}, {"t": "Энгийн ба аравтьн бутархай, процент", "ch": "БШУЯ теле хичээл", "min": 20.6, "url": "https://econtent.edu.mn/lessons/EBS/7rangi/mat/3373"}]}