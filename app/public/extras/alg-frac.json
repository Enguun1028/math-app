{"q": [{"level": 1, "q": "\\frac{x + 4}{x + 7} бутархайг хураах боломжтой юу?", "choices": ["Тийм: \\frac{4}{7}", "Үгүй: \\frac{x + 4}{x + 7} хэвээр үлдэнэ", "Тийм: \\frac{x + 4}{7}", "Тийм: 1"], "answer": 1, "why": "Зөвхөн үржигдэхүүнийг хураана. x нь энд нэмэгдэхүүн, тиймээс хураахгүй.", "traps": {"0": "Нэмэгдэхүүн x-ийг хураасан (зөвхөн үржигдэхүүнийг хураадаг).", "2": "Хуваарийн нэмэгдэхүүнийг л хураасан.", "3": "Хүртвэр ба хуваарь хоёулаа x агуулсан тул тэнцүү гэж үзсэн."}}, {"level": 1, "q": "\\frac{3x + 9}{3} = ?", "choices": ["3x + 3", "x + 9", "x + 3", "\\frac{x + 9}{3}"], "answer": 2, "why": "Хүртвэр 3(x + 3) тул 3-аар хураавал x + 3.", "traps": {"1": "Хүртвэрийн зөвхөн нэг гишүүнийг хураасан (3x-ийг).", "0": "Хүртвэрийн зөвхөн 9-ийг хураасан.", "3": "Хураасан ч хуваарийг хэвээр үлдээсэн."}}, {"level": 2, "q": "\\frac{2}{a} + \\frac{3}{b} = ?", "choices": ["\\frac{5}{a + b}", "\\frac{5}{ab}", "\\frac{6}{ab}", "\\frac{2b + 3a}{ab}"], "answer": 3, "why": "Ерөнхий хуваарь ab: \\frac{2b}{ab} + \\frac{3a}{ab} = \\frac{2b + 3a}{ab}.", "traps": {"0": "Алгебрын бутархайг хүртвэр, хуваариар нь нэмсэн.", "1": "Ерөнхий хуваарьт оруулахдаа хүртвэрийг үржүүлээгүй.", "2": "Нэмэхийн оронд үржүүлсэн."}}, {"level": 2, "q": "\\frac{x² − 4x}{x² − 16}-г хураана уу (x ≠ ±4).", "choices": ["\\frac{x}{x + 4}", "\\frac{x}{4}", "\\frac{1}{x + 4}", "\\frac{x}{x − 4}"], "answer": 0, "why": "x² − 4x = x(x − 4), x² − 16 = (x − 4)(x + 4). (x − 4)-өөр хураавал \\frac{x}{x + 4}.", "traps": {"1": "x² гишүүдийг хураасан (зөвхөн үржигдэхүүнийг хураадаг): \\frac{−4x}{−16} = \\frac{x}{4}.", "2": "Хүртвэрийн x үржигдэхүүнийг ч хураасан.", "3": "Хуваарийг задлахдаа буруу үржигдэхүүнээр хураасан."}}, {"level": 3, "q": "\\frac{1}{x − 2} − \\frac{1}{x + 2} = ?", "choices": ["0", "\\frac{4}{x² − 4}", "\\frac{−4}{x² − 4}", "\\frac{2x}{x² − 4}"], "answer": 1, "why": "Ерөнхий хуваарь (x − 2)(x + 2) = x² − 4: \\frac{(x + 2) − (x − 2)}{x² − 4} = \\frac{4}{x² − 4}.", "traps": {"0": "Алгебрын бутархайг хүртвэр, хуваариар нь хассан (1 − 1 = 0).", "2": "Хаалтын өмнөх хасахыг буруу хэрэглэж тэмдэг алдсан.", "3": "Хасахын оронд нэмсэн."}}], "mis": [{"wrong": "Гишүүнийг хураах (зөвхөн үржигдэхүүнийг хураадаг)", "example": "(x + 3)/(x + 5) = 3/5 гэх", "why": "Хураах нь гишүүнд биш, үржигдэхүүнд хэрэглэгддэгийг ойлгоогүй.", "fix": "x = 1 орлуулж 4/6 ≠ 3/5 гэдгийг харуулна.", "src": "https://etd.uwc.ac.za/handle/11394/6943"}, {"wrong": "Хүртвэрийн нэг гишүүнийг л хураах", "example": "(2x + 4)/2 = x + 4 гэх (зөв нь x + 2)", "why": "Хуваарь хүртвэрийн бүх гишүүнд үйлчилдгийг анзаардаггүй.", "fix": "(2x + 4)/2 = 2x/2 + 4/2 гэж салгаж бичүүлнэ.", "src": "https://etd.uwc.ac.za/handle/11394/6943"}, {"wrong": "Алгебрын бутархайг хүртвэр, хуваариар нь нэмэх", "example": "1/x + 1/y = 2/(x + y) гэх (зөв нь (x + y)/(xy))", "why": "Энгийн бутархайн нэмэх алдааг алгебрт давтдаг.", "fix": "x = 1, y = 1 орлуулж: 2 ≠ 1 гэдгийг харуулна.", "src": "https://openlearning.aalto.fi/question/type/stack/doc/doc.php/CAS/Buggy_rules.md"}], "rw": [{"title": "Хамтарсан ажил", "text": "Хоёр цорго саваа хамт дүүргэх хугацааг алгебрын бутархайгаар олно (жишээ тоо).", "mini": "Нэг цорго 3 цагт, нөгөө нь 6 цагт дүүргэдэг. Хамт? Хариу: 1/3 + 1/6 = 1/2, тиймээс 2 цаг.", "src": null}, {"title": "Дундаж хурд", "text": "Явах, ирэх хурд өөр бол дундаж хурд = 2ab/(a + b).", "mini": "60 ба 40 км/ц бол? Хариу: 2·60·40 : 100 = 48 км/ц.", "src": null}], "v": [{"t": "Алгебрын бутархайн нэмэх хасах үйлдлийн гүйцэтгэх", "ch": "С. Пагмадулам", "min": 6.9, "url": "https://www.youtube.com/watch?v=IpJ2VXvjP4A"}, {"t": "Алгебрийн бутархайг нэмэх, хасах үйлдэл", "ch": "Udval Altankhuu", "min": 2.5, "url": "https://www.youtube.com/watch?v=9GYJygQT3wk"}, {"t": "Алгебрын хялбар бутархайг нэмэх, хасах", "ch": "БШУЯ теле хичээл", "min": 19.4, "url": "https://econtent.edu.mn/lessons/EBS/8rangi/mat/3754"}, {"t": "М9.4аб. Алгебрын хялбар бутархайнуудыг  үржүүлэх, хуваах", "ch": "БШУЯ теле хичээл", "min": 20.0, "url": "https://econtent.edu.mn/lessons/EBS/9rangi/mat/3758"}], "esh": {"n": 4, "pts": 9.0}}