{"q": [{"level": 1, "q": "∫3x² dx-ийг олно уу.", "choices": ["6x + C", "3x³ + C", "x³", "x³ + C"], "answer": 3, "why": "∫3x² dx = 3 · \\frac{x³}{3} + C = x³ + C.", "traps": {"0": "Интегралын оронд уламжлал авсан.", "1": "Зэргийн интегралд шинэ илтгэгчид хуваахаа мартсан.", "2": "Тодорхойгүй интегралд + C-г мартсан."}}, {"level": 1, "q": "∫(4x + 1) dx-ийг олно уу.", "choices": ["2x² + x + C", "4 + C", "2x² + x", "4x² + x + C"], "answer": 0, "why": "∫4x dx = 2x², ∫1 dx = x: 2x² + x + C.", "traps": {"1": "Интегралын оронд уламжлал авсан.", "2": "Тодорхойгүй интегралд + C-г мартсан.", "3": "Зэргийн интегралд илтгэгчид хуваахаа мартсан."}}, {"level": 2, "q": "∫x⁴ dx-ийг олно уу.", "choices": ["4x³ + C", "\\frac{x⁵}{4} + C", "x⁵ + C", "\\frac{x⁵}{5} + C"], "answer": 3, "why": "∫xⁿ dx = \\frac{xⁿ⁺¹}{n + 1} + C: \\frac{x⁵}{5} + C.", "traps": {"0": "Интегралын оронд уламжлал авсан.", "1": "Хуучин илтгэгчид (4) хуваасан.", "2": "Зэргийн интегралд илтгэгчид хуваахаа мартсан."}}, {"level": 2, "q": "∫(3x − 2)² dx-ийг олно уу.", "choices": ["6(3x − 2) + C", "\\frac{(3x − 2)³}{3} + C", "\\frac{(3x − 2)³}{9} + C", "(3x − 2)³ + C"], "answer": 2, "why": "∫(ax + b)ⁿ dx = \\frac{(ax + b)ⁿ⁺¹}{a(n + 1)} + C: a = 3, n + 1 = 3, хуваарь 9.", "traps": {"0": "Интегралын оронд уламжлал авсан.", "1": "x-ийн коэффициент a = 3-т хуваахаа мартсан.", "3": "Зэргийн интегралд хуваахаа мартсан."}}, {"level": 3, "q": "\\frac{dy}{dx} = 6x − 2 бөгөөд муруй (1, 4) цэгийг дайрна. Муруйн тэгшитгэл аль вэ?", "choices": ["y = 3x² − 2x", "y = 3x² − 2x + 3", "y = 6x² − 2x", "y = 3x² − 2x + 4"], "answer": 1, "why": "y = 3x² − 2x + C; 4 = 3 − 2 + C тул C = 3.", "traps": {"0": "Тогтмол C-г мартсан.", "2": "Зэргийн интегралд илтгэгчид хуваахаа мартсан.", "3": "C-г олохдоо y-ийн утгыг шууд C гэж авсан."}}], "mis": [{"wrong": "Тодорхой бус интегралд + C-г мартдаг.", "example": "∫2x dx = x² гэнэ; зөв нь x² + C.", "why": "Уламжлал нь ижил олон функц байдгийг ойлгоогүй.", "fix": "x², x² + 5, x² − 3-ын уламжлалыг харьцуулуулна.", "src": "https://dx.doi.org/10.1007/BF00410540"}, {"wrong": "Зэргийн интегралд зэрэгт хуваахаа мартдаг.", "example": "∫x² dx = x³ + C гэнэ; зөв нь x³/3 + C.", "why": "Уламжлалын дүрмийг урвуугаар буруу хэрэглэдэг.", "fix": "Хариуны уламжлалыг авч шалгах дадал суулгана.", "src": "https://dx.doi.org/10.1007/BF00410540"}], "rw": [{"title": "Хурднаас зам", "text": "Хурдыг интегралчилбал туулсан зам гарна.", "mini": "v = 2t, t = 0-ээс 4. Зам? Хариу: ∫ 2t dt = 16 м.", "src": null}, {"title": "Усны урсгал", "text": "Хоолойгоор урсах усны хэмжээг урсгалын хурдны интегралаар олно.", "mini": "Тогтмол 3 л/мин, 20 мин? Хариу: 60 л.", "src": null}], "v": [{"t": "Интеграл эх функц   12 анги", "ch": "Мөнхбат Галиндэв", "min": 6.5, "url": "https://www.youtube.com/watch?v=67cI6_ZBGcw"}, {"t": "Тодорхой бус интеграл", "ch": "iMath математик сургалтын систем (8x100)", "min": 6.1, "url": "https://www.youtube.com/watch?v=Z0drkzxSahk"}, {"t": "Рационал илтгэгчтэй зэрэгт функцийн интеграл", "ch": "БШУЯ теле хичээл", "min": 19.2, "url": "https://econtent.edu.mn/lessons/EBS/11rangi/mat/2534"}, {"t": "Интеграл", "ch": "БШУЯ теле хичээл", "min": 20.2, "url": "https://econtent.edu.mn/lessons/EBS/12rangi/mat/1669"}], "it": [{"n": "Графикын Тооцоолол", "url": "https://phet.colorado.edu/sims/html/calculus-grapher/latest/calculus-grapher_mn.html", "k": "phet", "mn": true}, {"n": "Upper and lower Riemann Sums", "url": "https://www.geogebra.org/m/XxcwuUm3", "k": "geogebra", "mn": false}], "esh": {"n": 3, "pts": 5.0}}