{"q": [{"level": 1, "q": "2/5 × 3/4 = ?", "choices": ["3/10", "5/9", "8/15", "6/9"], "answer": 0, "why": "Хүртвэр: 2 × 3 = 6, хуваарь: 5 × 4 = 20. 6/20 = 3/10.", "traps": {"1": "Үржүүлэхийн оронд хүртвэр, хуваарийг нэмсэн.", "2": "Хөндлөн үржүүлсэн.", "3": "Хүртвэрийг үржүүлж, хуваарийг нэмсэн."}}, {"level": 1, "q": "12 × 1/4 = ?", "choices": ["48", "3", "1/48", "12 1/4"], "answer": 1, "why": "12 × 1/4 = 12/4 = 3. 1-ээс бага тоогоор үржүүлэхэд тоо багасна.", "traps": {"0": "Бутархайгаар үржихэд тоо ихэснэ гэж бодоод 12 × 4 гэсэн.", "2": "Хуваарьт үржүүлсэн.", "3": "Үржүүлэхийн оронд залгасан."}}, {"level": 2, "q": "6 : 1/3 = ?", "choices": ["2", "1/18", "18", "3"], "answer": 2, "why": "1/3-ийн урвуу тоо 3: 6 × 3 = 18. 1-ээс бага тоонд хуваахад тоо ихэснэ.", "traps": {"0": "Бутархайд хуваахад тоо багасна гэж бодоод 6 : 3 гэсэн.", "3": "Бутархайд хуваахад тоо багасна гэж бодож 6 : 2 гэсэн.", "1": "Урвуу тоог буруу газар хэрэглэсэн."}}, {"level": 2, "q": "4/5 : 2/3 = ?", "choices": ["8/15", "5/6", "2/15", "6/5"], "answer": 3, "why": "4/5 × 3/2 = 12/10 = 6/5.", "traps": {"1": "Хуваахдаа буруу бутархайг (хуваагдагчийг) эргүүлсэн.", "0": "Хуваагчийг эргүүлэхгүй шууд үржүүлсэн.", "2": "Хуваахын оронд хассан."}}, {"level": 3, "q": "Оюунд 3/4 кг гурил байв. Нэг бялуунд 1/8 кг гурил ордог. Хэдэн бялуу хийж болох вэ?", "choices": ["6", "3/32", "1/6", "8"], "answer": 0, "why": "3/4 : 1/8 = 3/4 × 8 = 6 бялуу.", "traps": {"1": "Бутархайд хуваахад тоо багасна гэж бодоод үржүүлсэн.", "2": "Хуваахдаа буруу бутархайг (3/4-ийг) эргүүлсэн.", "3": "Хуваарийг хариу гэж авсан."}}], "mis": [{"wrong": "Бутархайгаар үржихэд тоо ихэснэ гэж бодох", "example": "6 × 1/3-ыг 6-аас их гэж таамаглах (зөв нь 2)", "why": "Натурал тоон үржвэрийн туршлагыг ерөнхийлдөг.", "fix": "«6-ын гуравны нэг» гэж уншуулж зургаар үзүүлнэ.", "src": "https://pasithee.library.upatras.gr/ejupUNESCOchair/article/view/3210"}, {"wrong": "Бутархайд хуваахад тоо багасна гэж бодох", "example": "6 : 1/2 = 3 гэх (зөв нь 12)", "why": "Хуваахыг үргэлж «хагаслах, жижиглэх» гэж ойлгодог.", "fix": "«6-д хэдэн хагас багтах вэ?» гэж асууж зургаар тоолуулна.", "src": "https://pasithee.library.upatras.gr/ejupUNESCOchair/article/view/3210"}, {"wrong": "Хуваахдаа буруу бутархайг эргүүлэх", "example": "3/4 : 1/2 = 4/3 × 1/2 = 2/3 гэх (зөв нь 3/4 × 2 = 3/2)", "why": "«Эргүүлээд үржүүлнэ» дүрмийг утгагүй цээжилсэн.", "fix": "Хариуг шалгах: 3/2 × 1/2 = 3/4 болж байгаа эсэхийг үржүүлж батлуулна.", "src": "https://pasithee.library.upatras.gr/ejupUNESCOchair/article/view/3210"}], "rw": [{"title": "Жорыг багасгах", "text": "Жорыг 2/3 болгож багасгахад орц бүрийг 2/3-аар үржүүлнэ.", "mini": "3/4 аяга сүүг 2/3 болговол? Хариу: 3/4 × 2/3 = 1/2 аяга.", "src": null}, {"title": "Талбайн хэсэг", "text": "Газрын 3/4-д тариа тарьж, түүний 2/3-д нь улаан буудай бол бүхлийн хэдэд вэ?", "mini": "Хариу: 3/4 × 2/3 = 1/2.", "src": null}], "v": [{"t": "Энгийн бутархайг хуваах жишээ", "ch": "KhanAcademyMongolian", "min": 3.6, "url": "https://www.youtube.com/watch?v=2H5q65Zb7V0"}, {"t": "Энгийн бутархайн үржих ба хуваах үйлдэл", "ch": "sanjaa sanja", "min": 5.6, "url": "https://www.youtube.com/watch?v=0tmxxsX-r-k"}, {"t": "Энгийн бутархайн үйлдэл", "ch": "БШУЯ теле хичээл", "min": 14.4, "url": "https://econtent.edu.mn/lessons/EBS/7rangi/mat/3540"}], "it": [{"n": "Illustrative Mathematics Grade 6 Unit 4: Dividing Fractions", "url": "https://im.kendallhunt.com/MS/students/1/4/index.html", "k": "task", "mn": false}], "esh": {"n": 1, "pts": 2.0}}