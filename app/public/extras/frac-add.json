{"q": [{"level": 1, "q": "2/9 + 5/9 = ?", "choices": ["7/9", "7/18", "10/9", "3/9"], "answer": 0, "why": "Хуваарь ижил тул хүртвэрийг нэмж, хуваарийг хэвээр үлдээнэ: 7/9.", "traps": {"1": "Ижил хуваарьтай үед хуваарийг ч нэмсэн.", "2": "Хүртвэрүүдийг үржүүлсэн.", "3": "Нэмэхийн оронд хассан."}}, {"level": 1, "q": "7/8 − 3/8 = ?", "choices": ["4/0", "1/2", "4/16", "10/8"], "answer": 1, "why": "7/8 − 3/8 = 4/8 = 1/2. Хуваарь хэвээр үлдэнэ.", "traps": {"0": "Хуваариудыг ч хассан.", "2": "Ижил хуваарьтай үед хуваарийг нэмсэн.", "3": "Хасахын оронд нэмсэн."}}, {"level": 2, "q": "1/4 + 2/3 = ?", "choices": ["3/7", "3/12", "11/12", "2/12"], "answer": 2, "why": "Ерөнхий хуваарь 12: 1/4 = 3/12, 2/3 = 8/12. 3/12 + 8/12 = 11/12.", "traps": {"0": "Хүртвэрийг хүртвэртэй, хуваарийг хуваарьтай нэмсэн.", "1": "Ерөнхий хуваарьт оруулахдаа хүртвэрийг үржүүлээгүй.", "3": "Нэмэхийн оронд үржүүлсэн."}}, {"level": 2, "q": "5/6 − 1/4 = ?", "choices": ["4/2", "4/12", "6/10", "7/12"], "answer": 3, "why": "Ерөнхий хуваарь 12: 10/12 − 3/12 = 7/12.", "traps": {"0": "Хүртвэрийг хүртвэрээс, хуваарийг хуваариас хассан.", "1": "Ерөнхий хуваарьт оруулахдаа хүртвэрийг үржүүлээгүй.", "2": "Хасахын оронд хүртвэр, хуваарийг тус тусад нь нэмсэн."}}, {"level": 3, "q": "Сараа хашааны 1/3-ыг, Бат 2/5-ыг будав. Хашааны ямар хэсэг будагдаагүй үлдсэн бэ?", "choices": ["4/15", "12/15", "5/8", "11/15"], "answer": 0, "why": "Будсан: 1/3 + 2/5 = 5/15 + 6/15 = 11/15. Үлдсэн: 1 − 11/15 = 4/15.", "traps": {"2": "1/3 + 2/5-ыг хүртвэр, хуваариар нь нэмж 3/8 гэсэн.", "1": "Ерөнхий хуваарьт оруулахдаа хүртвэрийг үржүүлээгүй (1/15 + 2/15).", "3": "Будсан хэсгийг хариу болгосон."}}], "mis": [{"wrong": "Хүртвэрийг хүртвэртэй, хуваарийг хуваарьтай нэмэх", "example": "1/2 + 1/3 = 2/5 гэх (зөв нь 5/6)", "why": "Бүхэл тоон нэмэх дүрмийг бутархайн хэсэг бүрт хэрэглэдэг.", "fix": "1/2 + 1/3 нь 1/2-оос их байх ёстой гэтэл 2/5 бага гэдгийг зургаар харуулна.", "src": "https://www.nfer.ac.uk/assessment-hub/what-are-the-common-mistakes-when-adding-fractions/"}, {"wrong": "Ижил хуваарьтай үед хуваарийг ч нэмэх", "example": "2/7 + 3/7 = 5/14 гэх (зөв нь 5/7)", "why": "Хуваарь нь хэсгийн хэмжээ гэдгийг ойлгоогүй.", "fix": "Цаасыг 7 хэсэгт хувааж 2 ба 3 хэсгийг нийлүүлэхэд хэсгийн хэмжээ өөрчлөгдөхгүйг харуулна.", "src": "https://www.nfer.ac.uk/assessment-hub/what-are-the-common-mistakes-when-adding-fractions/"}, {"wrong": "Ерөнхий хуваарьт оруулахдаа хүртвэрийг үржүүлэхгүй", "example": "1/3 + 1/4 = 1/12 + 1/12 = 2/12 гэх (зөв нь 7/12)", "why": "Хуваарийг өөрчлөхөд хүртвэр ч өөрчлөгдөх ёстойг мэдэхгүй.", "fix": "1/3 = 4/12 гэдгийг зургаар баталж, «хүртвэр, хуваарийг ижил тоогоор үржүүлнэ» гэж хэлүүлнэ.", "src": "https://www.ncetm.org.uk/media/cocnx0it/misconceptions-with-the-key-objectives2.doc"}], "rw": [{"title": "Даалгаврын цаг", "text": "Хэд хэдэн ажлын хугацааг нэмэхэд бутархай нэмэх хэрэг гардаг.", "mini": "Математикт 1/2 цаг, англи хэлэнд 1/3 цаг зарцуулбал? Хариу: 5/6 цаг = 50 мин.", "src": null}, {"title": "Жор", "text": "Гурилаа 1/2 аяга, дараа нь 1/4 аяга нэмбэл нийт хэд болохыг бодно.", "mini": "1/2 + 1/4 = ? Хариу: 3/4 аяга.", "src": null}], "v": [{"t": "Энгийн бутархайг нэмэх ба хасах", "ch": "KhanAcademyMongolian", "min": 2.2, "url": "https://www.youtube.com/watch?v=PYOon_3teZo"}, {"t": "Холимог бутархайг нэмэх ба хасах", "ch": "KhanAcademyMongolian", "min": 2.2, "url": "https://www.youtube.com/watch?v=tRqV8MsFdkY"}, {"t": "Энгийн бутархайг нэмэх, хасах", "ch": "БШУЯ теле хичээл", "min": 17.7, "url": "https://econtent.edu.mn/lessons/EBS/5rangi/mat/3462"}, {"t": "Энгийн бутархайн үйлдэл", "ch": "БШУЯ теле хичээл", "min": 14.4, "url": "https://econtent.edu.mn/lessons/EBS/7rangi/mat/3540"}], "it": [{"n": "Бутархай: Тэнцэтгэл", "url": "https://phet.colorado.edu/sims/html/fractions-equality/latest/fractions-equality_mn.html", "k": "phet", "mn": true}]}