{"q": [{"level": 1, "q": "3⁴ = ?", "choices": ["12", "7", "64", "81"], "answer": 3, "why": "3⁴ = 3 · 3 · 3 · 3 = 81.", "traps": {"0": "Суурийг илтгэгчээр үржүүлсэн.", "2": "Суурь ба илтгэгчийг сольсон (4³).", "1": "Суурь ба илтгэгчийг нэмсэн."}}, {"level": 1, "q": "6² = ?", "choices": ["36", "12", "8", "62"], "answer": 0, "why": "6² = 6 · 6 = 36.", "traps": {"1": "Квадрат зэргийг 2-оор үржихтэй андуурсан.", "2": "Суурь ба илтгэгчийг нэмсэн.", "3": "Цифрүүдийг залгасан."}}, {"level": 2, "q": "3² · 3³-ийг нэг зэрэг хэлбэрээр бичнэ үү.", "choices": ["3⁶", "3⁵", "9⁵", "9⁶"], "answer": 1, "why": "Ижил суурьтай зэргийг үржүүлэхэд илтгэгчийг нэмнэ: 3²⁺³ = 3⁵.", "traps": {"0": "Ижил суурьтай зэргийг үржүүлэхэд илтгэгчийг үржүүлсэн.", "2": "Суурийг ч үржүүлсэн.", "3": "Суурийг үржүүлж, илтгэгчийг ч үржүүлсэн."}}, {"level": 2, "q": "2³ + 3² = ?", "choices": ["12", "15", "17", "14"], "answer": 2, "why": "2³ = 8, 3² = 9. 8 + 9 = 17.", "traps": {"0": "Суурийг илтгэгчээр үржүүлсэн (6 + 6).", "1": "2³-ыг 2 · 3 = 6 гэж бодсон.", "3": "3²-ыг 3 · 2 = 6 гэж, квадратыг 2-оор үржихтэй андуурсан."}}, {"level": 3, "q": "2⁵ · 2² : 2⁴ = ?", "choices": ["128", "64", "6", "8"], "answer": 3, "why": "2⁵ · 2² = 2⁷. 2⁷ : 2⁴ = 2³ = 8.", "traps": {"1": "Ижил суурьтай зэргийг үржүүлэхэд илтгэгчийг үржүүлсэн (2¹⁰ : 2⁴ = 2⁶).", "2": "Эцэст нь 2³-ыг 2 · 3 гэж бодсон.", "0": "2⁴-д хуваахаа мартсан."}}], "mis": [{"wrong": "Суурийг илтгэгчээр үржүүлэх", "example": "2³ = 6 гэх (зөв нь 8)", "why": "Зэргийг давтан үржвэр биш, ердийн үржвэр гэж ойлгодог.", "fix": "2³ = 2 × 2 × 2 гэж задлан бичүүлнэ.", "src": "https://map.mathshell.org/lessons.php?unit=8110&collection=8"}, {"wrong": "Квадрат зэргийг 2-оор үржихтэй андуурах", "example": "5² = 10 гэх (зөв нь 25)", "why": "Илтгэгч 2-ыг үржигдэхүүн гэж уншдаг.", "fix": "5 × 5 хэмжээтэй квадратын нүдийг тоолуулна.", "src": "https://eedi.substack.com/p/what-do-4-million-students-responses"}, {"wrong": "Ижил суурьтай зэргийг үржүүлэхэд илтгэгчийг үржүүлэх", "example": "2² × 2³ = 2⁶ гэх (зөв нь 2⁵ = 32)", "why": "aᵐ · aⁿ ба (aᵐ)ⁿ дүрмийг хольдог.", "fix": "2² × 2³ = (2 × 2) × (2 × 2 × 2) гэж задалж 2-ыг тоолуулна.", "src": "https://map.mathshell.org/lessons.php?unit=8110&collection=8"}], "rw": [{"title": "Компьютерийн санах ой", "text": "Компьютер 2-ын зэргээр ажилладаг: 1 KiB = 2¹⁰ = 1024 байт.", "mini": "2¹⁰ = ? Хариу: 1024.", "src": null}, {"title": "Бактери үржих", "text": "Бактери хоёр хуваагдаж үрждэг тул тоо нь 2-ын зэргээр өсдөг.", "mini": "1 бактери 5 удаа хуваагдвал? Хариу: 2⁵ = 32.", "src": null}], "v": [{"t": "Тооны тэг зэрэг гэж юу вэ?", "ch": "Авирмэдийн Бямбаа (Byambaa)", "min": 2.7, "url": "https://www.youtube.com/watch?v=8SaCncs0oc0"}, {"t": "Зэргийн чанар 1", "ch": "KhanAcademyMongolian", "min": 8.6, "url": "https://www.youtube.com/watch?v=oUMq3lCUSsw"}], "it": [{"n": "Illustrative Mathematics Grade 6 Unit 6: Expressions and Equations", "url": "https://im.kendallhunt.com/MS/students/1/6/index.html", "k": "task", "mn": false}]}