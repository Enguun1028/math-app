{"q": [{"level": 1, "q": "A = (1 2; 3 4), B = (5 0; −1 2) бол A + B = ?", "choices": ["(6 2; 4 6)", "(5 0; −3 8)", "(6 2; 2 6)", "(−4 2; 4 2)"], "answer": 2, "why": "Харгалзах элементүүдийг нэмнэ: (1 + 5, 2 + 0; 3 − 1, 4 + 2) = (6 2; 2 6).", "traps": {"1": "Нэмэхийн оронд харгалзах элементүүдийг үржүүлсэн.", "0": "−1-ийн тэмдгийг алдсан.", "3": "Нэмэхийн оронд хассан."}}, {"level": 1, "q": "2 × 3 хэмжээстэй A матрицыг 3 × 4 хэмжээстэй B матрицаар үржүүлэв. AB ямар хэмжээстэй вэ?", "choices": ["3 × 3", "Үржих боломжгүй", "4 × 2", "2 × 4"], "answer": 3, "why": "(m × n) · (n × k) = (m × k): (2 × 3) · (3 × 4) = 2 × 4.", "traps": {"0": "Дотоод хэмжээсүүдийг хариу гэж авсан.", "2": "AB-г BA-тай андуурч, хэмжээсийн дарааллыг сольсон.", "1": "Хэмжээс ижил биш бол үржихгүй гэж бодсон."}}, {"level": 2, "q": "(1 2; 0 3) · (2 1; 1 0) = ?", "choices": ["(4 1; 3 0)", "(2 2; 0 0)", "(2 7; 1 2)", "(3 3; 1 3)"], "answer": 0, "why": "Мөрийг баганаар үржүүлнэ: (1·2 + 2·1, 1·1 + 2·0; 0·2 + 3·1, 0·1 + 3·0) = (4 1; 3 0).", "traps": {"1": "Матрицыг харгалзах элементээр нь үржүүлсэн.", "2": "Үржвэрийг байр сэлгэнэ гэж үзээд BA-г бодсон.", "3": "Үржүүлэхийн оронд нэмсэн."}}, {"level": 2, "q": "A = (2 0; 1 3), E = (1 0; 0 1) бол AE = ?", "choices": ["(2 0; 0 3)", "(2 0; 1 3)", "(1 0; 0 1)", "(3 0; 1 4)"], "answer": 1, "why": "Нэгж матрицаар үржүүлэхэд матриц өөрчлөгдөхгүй: AE = A.", "traps": {"0": "Матрицыг харгалзах элементээр нь үржүүлсэн.", "2": "Нэгж матрицаар үржүүлэхэд нэгж матриц гарна гэж бодсон.", "3": "Үржүүлэхийн оронд нэмсэн."}}, {"level": 3, "q": "A = (1 1; 0 1), B = (1 0; 2 1) бол AB − BA = ?", "choices": ["(2 0; 0 −2)", "(0 0; 0 0)", "(−2 0; 0 2)", "(2 0; 0 2)", "(1 0; 0 1)"], "answer": 0, "why": "AB = (3 1; 2 1), BA = (1 1; 2 3). AB − BA = (2 0; 0 −2). Матрицын үржвэр байр сэлгэдэггүй.", "traps": {"1": "Матрицын үржвэрийг байр сэлгэнэ гэж бодсон (AB = BA).", "4": "Матрицыг харгалзах элементээр нь үржүүлсэн.", "2": "AB ба BA-ийн байрыг сольсон.", "3": "Хасахдаа тэмдгийг алдсан."}}], "mis": [{"wrong": "Матрицын үржвэрийг байр сэлгэнэ гэж бодох", "example": "A = [[1, 2], [0, 1]], B = [[1, 0], [1, 1]] үед AB = BA гэх (AB = [[3, 2], [1, 1]], BA = [[1, 2], [1, 3]])", "why": "Тооны үржвэрийн байр сэлгэх чанарыг матрицад шилжүүлдэг.", "fix": "Хоёр үржвэрийг бодуулж харьцуулуулна.", "src": "https://www.thecorestandards.org/Math/Content/HSN/VM/"}, {"wrong": "Матрицыг харгалзах элементээр нь үржүүлэх", "example": "[[1, 2], [3, 4]] · [[1, 0], [0, 1]] = [[1, 0], [0, 4]] гэх (зөв нь [[1, 2], [3, 4]])", "why": "Нэмэх дүрмийг (элемент тус бүр) үржих үйлдэлд хэрэглэдэг.", "fix": "Нэгж матрицаар үржүүлэхэд матриц өөрчлөгдөхгүй байх ёстойг жишээгээр харуулна.", "src": "https://www.thecorestandards.org/Math/Content/HSN/VM/"}], "rw": [{"title": "Зураг = матриц", "text": "Дижитал зураг бол пикселийн өнгөний матриц. Instagram-ын шүүлтүүр матриц дээр тооцоолол хийдэг.", "mini": "2 × 3 хэмжээтэй зургийн хэдэн пиксел? Хариу: 6.", "src": null}, {"title": "Дэлгүүрийн тооцоо", "text": "Тоо хэмжээ × үнэ-ийг матрицын үржвэрээр нэг дор бодно (жишээ тоо).", "mini": "[2 3] · [1500; 2000] = ? Хариу: 3000 + 6000 = 9000₮.", "src": null}], "v": [{"t": "Матрицийн нэмэх,хасах үйлдэл. Математик цуврал № 23", "ch": "chadna. mn", "min": 4.5, "url": "https://www.youtube.com/watch?v=6-GHC9lY-RQ"}, {"t": "Матрицийг үржүүлэх үйлдэл. № 25", "ch": "chadna. mn", "min": 6.8, "url": "https://www.youtube.com/watch?v=jPNYo376B2g"}, {"t": "Матрицын нэмэх, хасах, тоогоор үржүүлэх", "ch": "БШУЯ теле хичээл", "min": 16.3, "url": "https://econtent.edu.mn/lessons/EBS/10rangi/mat/3903"}], "esh": {"n": 2, "pts": 4.0}}